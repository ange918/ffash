generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  name             String
  adn_inspirations String?
  adn_valeurs      String[]
  adn_marche       String?
  adn_prix         String?
  adn_style        String?
  adn_synthese     String?
  projects         Project[]
  createdAt        DateTime  @default(now())
}

model Project {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  title        String
  theme        String?
  season       String?
  shareToken   String?         @unique
  generations  AiGeneration[]
  illustrations Illustration[]
  materials    Material[]
  createdAt    DateTime        @default(now())
}

model AiGeneration {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  type      String
  content   Json
  createdAt DateTime @default(now())
}

model Illustration {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  sketchUrl     String
  resultUrl     String
  inCertificate Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Material {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  content   Json
  createdAt DateTime @default(now())
}
